# Copy to .env.local for `npm run dev`.
#
# Where the Django service lives. On Vercel this is injected automatically by the
# `backend` service binding in vercel.json (as BACKEND_INTERNAL_URL), so it
# points at the Django build from the same deployment -- previews included.
# `vercel dev` injects it too; this fallback is only for a bare `npm run dev`
# alongside `make run-back`.
BACKEND_ORIGIN=http://127.0.0.1:8000
