# Copy to .env for local development.

# What this deployment is called wherever it names itself to people.
SITE_NAME=ehsundar
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to the local docker compose database when unset.
# On Vercel this is injected by the Neon integration and is required.
DATABASE_URL=postgres://ehsundar:ehsundar@localhost:5434/ehsundar

# Overrides the database name inside DATABASE_URL. Set on Vercel, where the Neon
# store is shared with another project and this platform owns its own database.
# DATABASE_NAME=ehsundar

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14


CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Resend API key for transactional email. Leave empty to print emails to the console.
RESEND_API_KEY=
# The sender's address; SITE_NAME is its display name.
EMAIL_FROM_ADDRESS=no-reply@localhost

# Where the frontend is served, for links in verification emails.
PUBLIC_ORIGIN=http://localhost:3000
