# Copy to .env for local development.

# What this deployment is called wherever it names itself to people.
FINEXITO_SITE_NAME=ehsundar
FINEXITO_SECRET_KEY=change-me
FINEXITO_DEBUG=true
FINEXITO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to the local docker compose database when unset.
FINEXITO_DATABASE_URL=postgres://ehsundar:ehsundar@localhost:5434/ehsundar

FINEXITO_ACCOUNTS_JWT_ACCESS_MINUTES=30
FINEXITO_ACCOUNTS_JWT_REFRESH_DAYS=14


FINEXITO_CORS_ALLOWED_ORIGINS=http://localhost:3000
FINEXITO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Resend API key for transactional email. Leave empty to print emails to the console.
FINEXITO_MESSAGING_RESEND_API_KEY=
# The sender's address; FINEXITO_SITE_NAME is its display name.
FINEXITO_MESSAGING_FROM_ADDRESS=no-reply@localhost

# Where the frontend is served, for links in verification emails.
FINEXITO_PUBLIC_ORIGIN=http://localhost:3000
