# The keys of the server's .env. Never copied as-is: on every deploy CI writes
# /opt/finexito/.env with each key taken from the GitHub secret or variable of
# the same name on the `production` environment, falling back to the value here.
# Keys left empty must be set in GitHub. `make deploy` appends IMAGE_TAG.

# --- where the site is served (variables) -------------------------------------
# The bare domain; www.<domain> redirects to it. Both need A/AAAA records
# pointing at the server (DNS only, not proxied) before Caddy can get a cert.
SITE_ADDRESS=
PUBLIC_ORIGIN=
DJANGO_ALLOWED_HOSTS=
SECURE_COOKIES=true
# Raise to 31536000 once HTTPS has been working for a while.
SECURE_HSTS_SECONDS=0
# What this deployment is called wherever it names itself to people.
SITE_NAME=
# The sender's address, on a domain verified in Resend; SITE_NAME is its display name.
EMAIL_FROM_ADDRESS=

# --- secrets -------------------------------------------------------------------
# Generate each with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-50
# POSTGRES_PASSWORD must stay the one the database volume was created with.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
RESEND_API_KEY=
