# Copy to deploy/.env on the server. Never commit the real one.

# --- where the site is served ------------------------------------------------
# The bare domain; www.<domain> redirects to it. Both need A/AAAA records
# pointing at the server (DNS only, not proxied) before Caddy can get a cert.
SITE_ADDRESS=example.com
PUBLIC_ORIGIN=https://example.com
DJANGO_ALLOWED_HOSTS=example.com
SECURE_COOKIES=true
# Raise to 31536000 once HTTPS has been working for a while.
SECURE_HSTS_SECONDS=0

# --- secrets -----------------------------------------------------------------
# Generate each with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-50
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- platform ----------------------------------------------------------------
DEFAULT_PROGRAM_SLUG=
