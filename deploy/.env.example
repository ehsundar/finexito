# The keys of the server's .env. Never copied as-is: on every deploy CI writes
# /opt/finexito/.env with each key taken from the GitHub secret or variable of
# the same name on the `production` environment, falling back to the value here.
# Keys left empty must be set in GitHub. `make deploy` appends IMAGE_TAG.

# --- where the site is served (variables) -------------------------------------
# The bare domain; www.<domain> redirects to it. Both need A/AAAA records
# pointing at the server (DNS only, not proxied) before Caddy can get a cert.
SITE_ADDRESS=
FINEXITO_PUBLIC_ORIGIN=
FINEXITO_ALLOWED_HOSTS=
FINEXITO_SECURE_COOKIES=true
# Raise to 31536000 once HTTPS has been working for a while.
FINEXITO_SECURE_HSTS_SECONDS=0
# What this deployment is called wherever it names itself to people.
FINEXITO_SITE_NAME=
# The sender's address, on a domain verified in Resend; FINEXITO_SITE_NAME is its display name.
FINEXITO_MESSAGING_FROM_ADDRESS=
# OAuth client for Sign in with Google, from the Google Cloud console.
FINEXITO_ACCOUNTS_GOOGLE_CLIENT_ID=
# New uploads go to buckets on an S3-compatible service (apps.storage); older
# ones stay on the server's disk. For Cloudflare R2 the endpoint is
# https://<account id>.r2.cloudflarestorage.com and the region `auto`. The
# public bucket is served from its custom domain.
FINEXITO_STORAGE_ENDPOINT_URL=
FINEXITO_STORAGE_REGION=auto
FINEXITO_STORAGE_PUBLIC_BUCKET=
FINEXITO_STORAGE_PUBLIC_DOMAIN=
FINEXITO_STORAGE_PRIVATE_BUCKET=

# --- secrets -------------------------------------------------------------------
# Generate each with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-50
# POSTGRES_PASSWORD must stay the one the database volume was created with.
FINEXITO_SECRET_KEY=
POSTGRES_PASSWORD=
FINEXITO_EMAIL_HOST_PASSWORD=
FINEXITO_ACCOUNTS_GOOGLE_CLIENT_SECRET=
# A key with read and write on the two buckets only (an R2 API token: Object Read & Write).
FINEXITO_STORAGE_ACCESS_KEY_ID=
FINEXITO_STORAGE_SECRET_ACCESS_KEY=
